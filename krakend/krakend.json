{
  "version": 3,
  "name": "KrakenD SOAP to GraphQL to SOAP (Go plugin)",
  "port": 8080,
  "timeout": "6s",
  "plugin": {
    "pattern": ".so",
    "folder": "/etc/krakend/plugins/"
  },
  "extra_config": {
    "router": {
      "return_error_msg": true
    },
    "plugin/http-server": {
      "name": [
        "soap-graphql-plugin"
      ],
      "soap-graphql-plugin": {
        "path": "/soap/cx",
        "method": "POST",
        "graphql_url": "http://graphql_svc:8000/graphql",
        "mapping_file": "/etc/krakend/mapping.json",
        "timeout_ms": 4500
      }
    }
  },
  "endpoints": [
    {
      "endpoint": "/soap/cx",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "SOAPAction"
      ],
      "backend": [
        {
          "url_pattern": "/graphql",
          "encoding": "no-op",
          "host": [
            "http://graphql_svc:8000"
          ]
        }
      ]
    }
  ]
}
